# Copy this file to ".env" and fill in your own values. Never upload the real .env.

# Team login for the admin (opens only at /login)
ADMIN_EMAIL=you@example.com
# Only used when the admin account is first created (empty = a random password is printed in the terminal)
ADMIN_PASSWORD=

# Gmail for "Forgot password?" links and new-order emails (SMTP_PASS = a Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
NOTIFY_EMAIL=you@example.com

# Public address of the store (used in emailed links), e.g. https://gaudhara.example.com
SITE_URL=http://localhost:3000

# Optional: phone verification at sign-up (off unless REQUIRE_OTP=on)
REQUIRE_OTP=
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE=
WA_OTP_TEMPLATE=
WA_TEMPLATE_LANG=en
WA_NUMBER=
WA_PHONE_ID=
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
VERIFY_TEST_MODE=off
